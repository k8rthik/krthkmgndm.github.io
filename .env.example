# Every environment variable the site reads. Defaults and docs live in
# serverEnv() in lib/config.js. Copy to .env.local for local development;
# set the real values in the Vercel project settings.

# password for adding/removing devlog entries; unset disables editing
DEVLOG_PASSWORD=

# fine-grained GitHub token with contents:write on GITHUB_REPO
GITHUB_TOKEN=

# optional overrides (defaults: k8rthik/krthkmgndm.github.io, main)
GITHUB_REPO=
GITHUB_BRANCH=
